<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--Vacsuit Mask-->
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="MR_Apparel_VacsuitHelmet"]/statBases</xpath>
		<value>
			<Bulk>6</Bulk>
			<WornBulk>2</WornBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="MR_Apparel_VacsuitHelmet"]/statBases/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>4</ArmorRating_Sharp>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="MR_Apparel_VacsuitHelmet"]/statBases/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>6</ArmorRating_Blunt>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="MR_Apparel_VacsuitHelmet"]/equippedStatOffsets</xpath>
		<value>
			<SmokeSensitivity>-1</SmokeSensitivity>
		</value>
	</Operation>
	
	<!--Vacsuit-->
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="MR_Apparel_Vacsuit"]/statBases</xpath>
		<value>
			<Bulk>40</Bulk>
			<WornBulk>12</WornBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="MR_Apparel_Vacsuit"]/statBases/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>10</ArmorRating_Sharp>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="MR_Apparel_Vacsuit"]/statBases/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>22.5</ArmorRating_Blunt>
		</value>
	</Operation>

	<!--Child Suit-->
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="MR_ChildAPP_Vacsuit"]/statBases</xpath>
		<value>
			<Bulk>6</Bulk>
			<WornBulk>2</WornBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="MR_ChildAPP_Vacsuit"]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>3</StuffEffectMultiplierArmor>
		</value>
	</Operation>
	
</Patch>
